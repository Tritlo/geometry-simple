cabal-version: 3.4
name: geometry-simple-dev
version: 0.1.0.0
build-type: Simple
license: MIT AND LicenseRef-OGC-Document
license-files:
  LICENSE
  LICENSE-OGC

author: Matthias Pall Gissurarson
maintainer: mpg@mpg.is
synopsis: Development checks for geometry-simple
description: Tests, benchmarks, and comparison tools for the repository. This package is not published.
category: Testing
extra-source-files:
  bench/report.py
  test/shapely_compare.py
  test/test_dev_tools.py
  test/test_duckdb_wkt.py
  test/test_numeric_limits.py
  test/test_overlay_precision.py
  test/test_shapely_compare.py

extra-doc-files:
  test/SFA-TESTS.md

test-suite geometry-simple-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    MeasureTests
    SFAConformanceTests
    SimpleFeaturesTests
    TopologyBufferTests
    TopologyOverlayTests
    TopologyRelationTests
    TopologyUnaryTests
    WKTTests

  hs-source-dirs: test
  default-language: Haskell2010
  build-depends:
    base >=4.18 && <5,
    bytestring >=0.11.2 && <0.13,
    geometry-simple ==0.1.0.0,
    QuickCheck >=2.14 && <2.20,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.12,
    tasty-quickcheck >=0.10 && <0.12,
    text >=2.0 && <2.2,
    vector >=0.13 && <0.14,

benchmark geometry-simple-bench
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules: Audit
  hs-source-dirs: bench
  default-language: Haskell2010
  ghc-options: -rtsopts
  build-depends:
    base >=4.18 && <5,
    bytestring >=0.11.2 && <0.13,
    deepseq >=1.4.8 && <1.6,
    geometry-simple ==0.1.0.0,
    text >=2.0 && <2.2,
    vector >=0.13 && <0.14,

executable geometry-simple-shapely-probe
  main-is: ShapelyProbe.hs
  hs-source-dirs: test
  default-language: Haskell2010
  build-depends:
    base >=4.18 && <5,
    bytestring >=0.11.2 && <0.13,
    geometry-simple ==0.1.0.0,
    text >=2.0 && <2.2,
    vector >=0.13 && <0.14,
