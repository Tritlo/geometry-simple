cabal-version: 3.4
name: geometry-simple
version: 0.1.0.0
license: MIT
license-file: LICENSE
author: Matthias Pall Gissurarson
maintainer: mpg@mpg.is
category: Data, Geometry
build-type: Simple
tested-with:
  ghc ==9.10.3
  ghc ==9.12.4
  ghc ==9.14.1
  ghc ==9.6.7
  ghc ==9.8.4

homepage: https://github.com/Tritlo/geometry-simple
bug-reports: https://github.com/Tritlo/geometry-simple/issues
synopsis: Simple Features geometries, codecs, and pure planar operations
description:
  Geometry values for the seven OGC Simple Features families: points,
  linestrings, polygons, their multi-geometry forms, and geometry collections.
  Coordinates are XY, XYZ, XYM, or XYZM, and coordinate sequences are stored
  in unboxed vectors.

  "Data.Geometry.WKB" and "Data.Geometry.WKT" read and write ISO WKB and WKT.
  The codecs check input structure, coordinate dimensions, line lengths,
  and ring closure. "Data.Geometry.SimpleFeatures" has accessors, planar
  measurements, spatial predicates, validity checks, overlays, round buffers,
  and measured-location queries.

  The package needs no native library or database.

extra-doc-files:
  CHANGELOG.md
  CONTRIBUTING.md
  README.md
  test/SFA-TESTS.md

extra-source-files: test/shapely_compare.py

flag shapely-tests
  description: Build the driver for the optional Shapely comparison tests
  default: False
  manual: True

source-repository head
  type: git
  location: https://github.com/Tritlo/geometry-simple.git

library
  exposed-modules:
    Data.Geometry
    Data.Geometry.Internal
    Data.Geometry.SimpleFeatures
    Data.Geometry.WKB
    Data.Geometry.WKT

  hs-source-dirs: src
  other-modules:
    Data.Geometry.Topology.Buffer
    Data.Geometry.Topology.Measures
    Data.Geometry.Topology.Ordinates
    Data.Geometry.Topology.Overlay
    Data.Geometry.Topology.Planar
    Data.Geometry.Topology.Relations
    Data.Geometry.Topology.Unary

  default-language: Haskell2010
  build-depends:
    base >=4.18 && <5,
    binary >=0.8 && <0.9,
    bytestring >=0.11.2 && <0.13,
    containers >=0.6 && <0.9,
    deepseq >=1.4.8 && <1.6,
    text >=2.0 && <2.2,
    transformers >=0.6 && <0.7,
    vector >=0.13 && <0.14,

test-suite geometry-simple-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    MeasureTests
    SFAConformanceTests
    SimpleFeaturesTests
    TopologyBufferTests
    TopologyOverlayTests
    TopologyRelationTests
    TopologyUnaryTests
    WKTTests

  hs-source-dirs: test
  default-language: Haskell2010
  build-depends:
    base >=4.18 && <5,
    bytestring >=0.11.2 && <0.13,
    geometry-simple,
    QuickCheck >=2.14 && <2.20,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.12,
    tasty-quickcheck >=0.10 && <0.12,
    text >=2.0 && <2.2,
    vector >=0.13 && <0.14,

benchmark geometry-simple-bench
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: bench
  default-language: Haskell2010
  ghc-options: -rtsopts
  build-depends:
    base >=4.18 && <5,
    bytestring >=0.11.2 && <0.13,
    geometry-simple,
    text >=2.0 && <2.2,
    vector >=0.13 && <0.14,

executable geometry-simple-shapely-probe
  if !flag(shapely-tests)
    buildable: False
  main-is: ShapelyProbe.hs
  hs-source-dirs: test
  default-language: Haskell2010
  build-depends:
    base >=4.18 && <5,
    bytestring >=0.11.2 && <0.13,
    geometry-simple,
    text >=2.0 && <2.2,
    vector >=0.13 && <0.14,
